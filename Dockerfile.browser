# Modo alternativo sin 2captcha: Chromium headless via Playwright (~815 MB).
FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir requests playwright==1.63.0 \
 && python -m playwright install --only-shell chromium \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      libnss3 libnspr4 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 \
      libcups2t64 libdrm2 libdbus-1-3 libexpat1 libgbm1 libglib2.0-0t64 \
      libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
      libxrandr2 libxkbcommon0 libasound2t64 libpango-1.0-0 libcairo2 \
      libfontconfig1 libxshmfence1 libx11-xcb1 \
 && rm -rf /var/lib/apt/lists/*

COPY bot.py .
ENV CAPTCHA_MODE=browser

CMD ["python", "bot.py"]
