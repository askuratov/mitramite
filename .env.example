# Токен от @BotFather. Обязательно.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# API key 2captcha (https://2captcha.com). Обязательно в режиме по умолчанию.
# ВАЖНО: в zsh/bash нельзя `export 2CAPTCHA_API_KEY=...` (имя начинается с цифры).
# В этом файле .env всё работает; для shell используй:
#   env '2CAPTCHA_API_KEY=...' python bot.py
# (принятый алиас: TWOCAPTCHA_API_KEY)
2CAPTCHA_API_KEY=

# Опционально: ограничить бота этими chat id (через запятую). Пусто = открыт всем.
# Узнать свой — отправь боту /id.
ALLOWED_CHAT_IDS=

# Опционально
# LOG_LEVEL=off                # "off" (default) = логи выключены; INFO только для ручной отладки
# CAPTCHA_MODE=2captcha        # или "browser" (нужен образ Dockerfile.browser)
# HEALTHCHECK_INTERVAL=86400   # сек; 0 = не перепроверять site key/action на сайте
# RECAPTCHA_ENTERPRISE=0       # обычно определяется автоматически
# RATE_LIMIT_MIN_INTERVAL=180  # сек между запросами одного пользователя (0 = без лимита)
# RATE_LIMIT_DAILY=50           # запросов на пользователя в сутки (0 = без лимита)
# TWOCAPTCHA_BASE=https://2captcha.com
# TWOCAPTCHA_MIN_SCORE=0.3
# TWOCAPTCHA_POLL=5
# TWOCAPTCHA_TIMEOUT=180
# RENAPER_BASE=https://mitramite.renaper.gob.ar
# RENAPER_SITE_KEY=6Ld2mMAbAAAAAM9grHC4aJ6pJT1TtvUz04q4Fvjs
# RECAPTCHA_ACTION=submit_tramite
# HTTP_TIMEOUT=25
