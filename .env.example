# Token de @BotFather. Obligatorio.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# API key de 2captcha (https://2captcha.com). Obligatorio en el modo por defecto.
# OJO: en zsh/bash NO se puede `export 2CAPTCHA_API_KEY=...` (empieza con digito).
# En este archivo .env funciona; para shell usa:
#   env '2CAPTCHA_API_KEY=...' python bot.py
# (alias aceptado: TWOCAPTCHA_API_KEY)
2CAPTCHA_API_KEY=

# Opcional: limita el bot a estos chat ids (separados por coma). Vacio = abierto.
# Manda /id al bot para averiguar el tuyo.
ALLOWED_CHAT_IDS=

# Opcional
# LOG_LEVEL=off                # "off" (default) = sin logs; INFO solo para depurar a mano
# CAPTCHA_MODE=2captcha        # o "browser" (requiere imagen Dockerfile.browser)
# HEALTHCHECK_INTERVAL=86400   # seg; 0 = no revalidar site key/action contra el sitio
# RECAPTCHA_ENTERPRISE=0       # normalmente se detecta solo
# RATE_LIMIT_MIN_INTERVAL=180  # seg entre consultas por chat (0 = sin limite)
# RATE_LIMIT_DAILY=10          # consultas por chat al dia (0 = sin limite)
# TWOCAPTCHA_BASE=https://2captcha.com
# TWOCAPTCHA_MIN_SCORE=0.3
# TWOCAPTCHA_POLL=5
# TWOCAPTCHA_TIMEOUT=180
# RENAPER_BASE=https://mitramite.renaper.gob.ar
# RENAPER_SITE_KEY=6Ld2mMAbAAAAAM9grHC4aJ6pJT1TtvUz04q4Fvjs
# RECAPTCHA_ACTION=submit_tramite
# HTTP_TIMEOUT=25
